import Certs.Basic

/-!
# Cap set in `F_3^4` of size 20

A cap set contains no three distinct collinear points. Over `F_3` the third point
on the line through `a` and `b` is determined, so the property is a finite check.

Coordinates are listed least-significant first. Generated by the `ramanujan`
harness; the theorems below are what make it a result rather than an assertion.
-/

namespace Certs

def capset4_20 : List (List Nat) :=
  [
    [2, 0, 1, 0],
    [2, 1, 1, 0],
    [0, 2, 1, 0],
    [1, 2, 1, 0],
    [0, 0, 2, 0],
    [0, 1, 2, 0],
    [1, 2, 2, 0],
    [2, 2, 2, 0],
    [1, 0, 0, 1],
    [2, 0, 1, 1],
    [1, 1, 2, 1],
    [2, 1, 2, 1],
    [1, 2, 2, 1],
    [2, 2, 2, 1],
    [1, 1, 0, 2],
    [0, 0, 1, 2],
    [1, 0, 1, 2],
    [0, 2, 1, 2],
    [1, 2, 1, 2],
    [0, 1, 2, 2]
  ]

theorem capset4_20_isCap : capOK 4 capset4_20 = true := by decide

theorem capset4_20_card : capset4_20.length = 20 := by rfl

end Certs
